<mujoco model="mini_mec">
  <!--
    迷你 4WD 小车 + 跟随目标“人”，摆在一块带草坪、小路和树的小空地上。

    物理部分和第一版完全一致：车体/轮子尺寸、自由关节、测距传感器、马达都没动。
    新加的环境和车壳细节全是“纯视觉件”：density=0（不算质量），
    contype/conaffinity=0（不参与碰撞和激光），只负责好看。
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002"/>

  <visual>
    <global offwidth="1280" offheight="720" fovy="45"/>
    <quality shadowsize="4096" offsamples="4"/>
    <map znear="0.01" zfar="80" haze="0.10" shadowclip="2"/>
    <rgba haze="0.82 0.88 0.95 1"/>
    <headlight ambient="0.18 0.18 0.20" diffuse="0.35 0.35 0.35" specular="0.05 0.05 0.05"/>
  </visual>

  <!-- 自由视角默认离场景 4 个单位，别一上来就飞得太远 -->
  <statistic center="0 0 0.5" extent="4"/>

  <asset>
    <!-- 天空：上蓝下白的渐变天空盒（rgb1 天顶，rgb2 地平线） -->
    <texture name="sky" type="skybox" builtin="gradient" width="512" height="512"
             rgb1="0.38 0.60 0.88" rgb2="0.90 0.94 0.99"/>
    <!-- 草坪：两种很接近的绿色交替，远看是草，近看有细微纹理 -->
    <texture name="grass" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.37 0.51 0.29" rgb2="0.33 0.47 0.26"/>

    <material name="grass" texture="grass" texrepeat="30 30" specular="0.02"/>
    <material name="path"   rgba="0.64 0.62 0.58 1" specular="0.12" shininess="0.2"/>
    <material name="shell"  rgba="0.09 0.34 0.32 1" specular="0.40" shininess="0.6"/>
    <material name="deck"   rgba="0.16 0.45 0.41 1" specular="0.40" shininess="0.6"/>
    <material name="dark"   rgba="0.10 0.11 0.12 1" specular="0.10" shininess="0.3"/>
    <material name="tyre"   rgba="0.10 0.11 0.12 1" specular="0.10" shininess="0.2"/>
    <material name="hub"    rgba="0.72 0.74 0.78 1" specular="0.70" shininess="0.9"/>
    <material name="lamp"   rgba="1.00 0.96 0.86 1" emission="0.9"/>
    <material name="tail"   rgba="0.80 0.10 0.08 1" emission="0.3"/>
    <!-- 橙色外套：摄像头就是靠“橙色像素”认出人的 -->
    <material name="person" rgba="0.92 0.42 0.20 1"/>
    <material name="skin"   rgba="0.95 0.76 0.60 1"/>
    <material name="hair"   rgba="0.13 0.11 0.10 1"/>
    <material name="bark"   rgba="0.34 0.30 0.26 1"/>
    <material name="leaf_a" rgba="0.24 0.44 0.21 1"/>
    <material name="leaf_b" rgba="0.30 0.52 0.25 1"/>
    <material name="rock"   rgba="0.58 0.57 0.55 1" specular="0.15"/>
  </asset>

  <worldbody>
    <!-- 太阳：一盏会投影的暖色平行光，树和车的影子都靠它 -->
    <light name="sun" type="directional" pos="-2 -3 8" dir="0.45 0.55 -1"
           diffuse="0.95 0.90 0.80" specular="0.35 0.33 0.30" castshadow="true"/>

    <geom name="floor" type="plane" size="20 20 0.1" material="grass"/>
    <!-- 一条浅灰石板路：纯装饰，1 mm 厚，车从上面开过不产生任何碰撞 -->
    <geom name="path" type="box" pos="0 0 0.0005" size="6 0.45 0.0005" material="path"
          contype="0" conaffinity="0"/>

    <!-- 树：树干 + 三团树冠。纯视觉件，车会直接穿过去 -->
    <body name="tree_a" pos="3.4 2.9 0">
      <geom type="cylinder" fromto="0 0 0 0 0 0.85" size="0.075" material="bark"
            contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.10" size="0.62" material="leaf_a" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0.30 0.12 1.40" size="0.42" material="leaf_b" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="-0.28 -0.16 1.32" size="0.38" material="leaf_a" contype="0" conaffinity="0"/>
    </body>
    <body name="tree_b" pos="-2.9 2.6 0">
      <geom type="cylinder" fromto="0 0 0 0 0 0.75" size="0.065" material="bark"
            contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 0.98" size="0.55" material="leaf_b" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0.24 -0.10 1.24" size="0.36" material="leaf_a" contype="0" conaffinity="0"/>
    </body>
    <body name="tree_c" pos="5.6 -2.0 0">
      <geom type="cylinder" fromto="0 0 0 0 0 0.95" size="0.08" material="bark"
            contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.20" size="0.66" material="leaf_a" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="-0.30 0.10 1.52" size="0.44" material="leaf_b" contype="0" conaffinity="0"/>
    </body>
    <body name="tree_d" pos="-4.4 -2.6 0">
      <geom type="cylinder" fromto="0 0 0 0 0 0.80" size="0.07" material="bark"
            contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.02" size="0.58" material="leaf_b" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0.22 0.14 1.30" size="0.38" material="leaf_a" contype="0" conaffinity="0"/>
    </body>
    <body name="tree_e" pos="1.4 -4.8 0">
      <geom type="cylinder" fromto="0 0 0 0 0 0.70" size="0.06" material="bark"
            contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 0.92" size="0.52" material="leaf_a" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="-0.22 -0.12 1.18" size="0.34" material="leaf_b" contype="0" conaffinity="0"/>
    </body>
    <body name="tree_f" pos="8.2 2.4 0">
      <geom type="cylinder" fromto="0 0 0 0 0 0.90" size="0.075" material="bark"
            contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.12" size="0.62" material="leaf_b" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0.28 -0.12 1.44" size="0.42" material="leaf_a" contype="0" conaffinity="0"/>
    </body>

    <!-- 灌木和石头：散布在路边的点缀 -->
    <body name="bush_a" pos="2.4 1.7 0">
      <geom type="sphere" pos="0 0 0.22" size="0.26" material="leaf_b" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0.20 0.10 0.18" size="0.20" material="leaf_a" contype="0" conaffinity="0"/>
    </body>
    <body name="bush_b" pos="-1.8 -1.9 0">
      <geom type="sphere" pos="0 0 0.20" size="0.24" material="leaf_a" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="-0.18 -0.08 0.16" size="0.18" material="leaf_b" contype="0" conaffinity="0"/>
    </body>
    <body name="bush_c" pos="-3.1 0.9 0">
      <geom type="sphere" pos="0 0 0.18" size="0.22" material="leaf_b" contype="0" conaffinity="0"/>
    </body>
    <body name="bush_d" pos="4.6 4.3 0">
      <geom type="sphere" pos="0 0 0.24" size="0.28" material="leaf_a" contype="0" conaffinity="0"/>
    </body>

    <body name="rock_a" pos="-1.2 2.1 0">
      <geom type="ellipsoid" pos="0 0 0.13" size="0.28 0.22 0.16" material="rock"
            contype="0" conaffinity="0"/>
    </body>
    <body name="rock_b" pos="2.1 -3.3 0">
      <geom type="ellipsoid" pos="0 0 0.10" size="0.22 0.18 0.13" material="rock"
            contype="0" conaffinity="0"/>
    </body>
    <body name="rock_c" pos="5.0 0.7 0">
      <geom type="sphere" pos="0 0 0.12" size="0.16" material="rock" contype="0" conaffinity="0"/>
    </body>

    <!-- 第三人称俯瞰镜头：按 ] 依次切换 车头视角 → 俯瞰视角，Esc 回自由视角 -->
    <camera name="overview" mode="targetbody" target="chassis" pos="3.2 -3.2 2.4"/>

    <!-- 跟随目标：站在车前方 2 米的“人”
         z = 0.61 让胶囊下端（-0.45 - 半径 0.16）刚好落在地面上。
         自由关节 + gravcomp 关掉重力：这样才能在窗口里用鼠标拖它，
         松手后它就停在那儿，不会倒也不会掉。 -->
    <body name="person" pos="2.0 0 0.61" gravcomp="1">
      <freejoint name="person_root"/>
      <geom type="capsule" fromto="0 0 -0.45 0 0 0.45" size="0.16" material="person"/>
      <geom type="sphere" pos="0 0 0.66" size="0.12" material="skin"/>
      <!-- 头发：视觉件，只盖住头顶，不影响碰撞和测距 -->
      <geom type="sphere" pos="0 0.02 0.73" size="0.115" material="hair"
            density="0" contype="0" conaffinity="0"/>
    </body>

    <!-- 车体：可以整体移动，所以挂一个自由关节 -->
    <body name="chassis" pos="0 0 0.09">
      <freejoint name="root"/>
      <geom name="shell" type="box" size="0.15 0.125 0.04" material="shell"/>
      <!-- 车顶设备盒 + 前部镜头罩 + 天线：纯装饰（density=0，不算质量） -->
      <geom name="deck" type="box" pos="-0.01 0 0.048" size="0.085 0.075 0.012"
            material="deck" density="0" contype="0" conaffinity="0"/>
      <geom name="cam_housing" type="box" pos="0.145 0 0.105" size="0.020 0.028 0.020"
            material="deck" density="0" contype="0" conaffinity="0"/>
      <geom name="antenna" type="capsule" fromto="-0.12 0.08 0.04 -0.12 0.08 0.22"
            size="0.004" material="dark" density="0" contype="0" conaffinity="0"/>
      <geom name="antenna_tip" type="sphere" pos="-0.12 0.08 0.22" size="0.010"
            material="lamp" density="0" contype="0" conaffinity="0"/>
      <!-- 前后车灯：小圆点，视觉件 -->
      <geom name="lamp_l" type="sphere" pos="0.147 0.085 0.015" size="0.010"
            material="lamp" density="0" contype="0" conaffinity="0"/>
      <geom name="lamp_r" type="sphere" pos="0.147 -0.085 0.015" size="0.010"
            material="lamp" density="0" contype="0" conaffinity="0"/>
      <geom name="tail_l" type="sphere" pos="-0.149 0.090 0.015" size="0.008"
            material="tail" density="0" contype="0" conaffinity="0"/>
      <geom name="tail_r" type="sphere" pos="-0.149 -0.090 0.015" size="0.008"
            material="tail" density="0" contype="0" conaffinity="0"/>
      <!-- 车头指示条：让“车头朝哪”一眼可见；不参与碰撞，也不挡测距 -->
      <geom name="nose" type="capsule" fromto="0.14 0 0 0.30 0 0" size="0.010"
            rgba="1 0.35 0.10 1" density="0" contype="0" conaffinity="0"/>
      <!-- 车头参考点（真实车头在 0.13149 m） -->
      <site name="front" pos="0.13149 0 0" size="0.012" rgba="1 0.2 0.2 1"/>
      <!-- 测距传感器：rangefinder 沿 site 的 z 轴发射，所以绕 y 转 90° 让它朝正前方 -->
      <site name="range_front" pos="0.16 0 0" euler="0 90 0" size="0.008" rgba="1 1 0 1"/>
      <!-- 车载摄像头：装在车头，镜头朝正前方。控制程序从这里“看”人 -->
      <camera name="eye" pos="0.175 0 0.12" xyaxes="0 -1 0 0 0 1" fovy="65"/>

      <!-- 四个轮子：绕 y 轴（左右轴）旋转 -->
      <body name="wheel_fl" pos="0.10  0.150 -0.04">
        <joint name="j_fl" type="hinge" axis="0 1 0" armature="0.01"/>
        <geom type="cylinder" size="0.05 0.018" euler="90 0 0" material="tyre"/>
        <geom type="cylinder" size="0.030 0.019" euler="90 0 0" material="hub"
              density="0" contype="0" conaffinity="0"/>
      </body>
      <body name="wheel_fr" pos="0.10 -0.150 -0.04">
        <joint name="j_fr" type="hinge" axis="0 1 0" armature="0.01"/>
        <geom type="cylinder" size="0.05 0.018" euler="90 0 0" material="tyre"/>
        <geom type="cylinder" size="0.030 0.019" euler="90 0 0" material="hub"
              density="0" contype="0" conaffinity="0"/>
      </body>
      <body name="wheel_rl" pos="-0.10  0.150 -0.04">
        <joint name="j_rl" type="hinge" axis="0 1 0" armature="0.01"/>
        <geom type="cylinder" size="0.05 0.018" euler="90 0 0" material="tyre"/>
        <geom type="cylinder" size="0.030 0.019" euler="90 0 0" material="hub"
              density="0" contype="0" conaffinity="0"/>
      </body>
      <body name="wheel_rr" pos="-0.10 -0.150 -0.04">
        <joint name="j_rr" type="hinge" axis="0 1 0" armature="0.01"/>
        <geom type="cylinder" size="0.05 0.018" euler="90 0 0" material="tyre"/>
        <geom type="cylinder" size="0.030 0.019" euler="90 0 0" material="hub"
              density="0" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <!-- 车身与轮子不要互相碰撞（否则会数值爆炸） -->
  <contact>
    <exclude body1="chassis" body2="wheel_fl"/>
    <exclude body1="chassis" body2="wheel_fr"/>
    <exclude body1="chassis" body2="wheel_rl"/>
    <exclude body1="chassis" body2="wheel_rr"/>
  </contact>

  <!-- 前方测距：一束激光沿车头方向打出去，量到最近障碍物的距离（米） -->
  <sensor>
    <rangefinder name="front_range" site="range_front" cutoff="6"/>
  </sensor>

  <!-- 四个“马达”：ctrl 是目标轮速（rad/s），kv 是跟随强度，forcerange 是力矩上限 -->
  <actuator>
    <velocity name="motor_fl" joint="j_fl" kv="5" forcerange="-3 3" ctrlrange="-10 10"/>
    <velocity name="motor_fr" joint="j_fr" kv="5" forcerange="-3 3" ctrlrange="-10 10"/>
    <velocity name="motor_rl" joint="j_rl" kv="5" forcerange="-3 3" ctrlrange="-10 10"/>
    <velocity name="motor_rr" joint="j_rr" kv="5" forcerange="-3 3" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
